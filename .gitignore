# keeps generated and local files out of version control

# compiled output
/dist
/tmp
/out-tsc
/bazel-out

# node dependencies and logs
/node_modules
npm-debug.log
yarn-error.log

# editors and development tools
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# visual studio code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# development output and caches
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# operating system files
.DS_Store
Thumbs.db
